rules_version = '2';

// Incident photos live at incidents/{incidentId}/{file} (docs/ARCHITECTURE.md §6).
// The uploader's uid is stored as custom metadata `reporterId`, so reads can
// be checked without a Firestore lookup.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOfficer() { return signedIn() && request.auth.token.role in ['officer', 'admin']; }
    function isMember() {
      return signedIn() && request.auth.token.verified == true
        && request.auth.token.role in ['student', 'staff'];
    }

    match /incidents/{incidentId}/{fileName} {
      allow read: if isOfficer()
        || (signedIn() && resource.metadata.reporterId == request.auth.uid);

      // Photos only (no video in the MVP), under 2 MB. Members tag uploads
      // with themselves as reporter; officers adding a chat photo tag it
      // with the incident's reporter so the reporter can open it.
      // Evidence can't be replaced or deleted — uploading over an existing
      // file counts as `create`, hence `resource == null`.
      allow create: if resource == null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 2 * 1024 * 1024
        && ((isMember() && request.resource.metadata.reporterId == request.auth.uid)
            || (isOfficer() && request.resource.metadata.reporterId is string));
      allow update, delete: if false;
    }

    // Everything else is locked.
  }
}
