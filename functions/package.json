{
  "name": "functions",
  "description": "Cloud Functions for the VVU Campus Safety app",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
