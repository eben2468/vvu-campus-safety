{
  "name": "functions",
  "description": "Cloud Functions for the VVU Campus Safety app",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint src test scripts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"lib-test/test/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-vvu-campus-safety \"npm run test:rules:run\"",
    "test:rules:run": "npm run build:test && node --test --test-concurrency=1 \"lib-test/test/rules/**/*.test.js\"",
    "seed": "npm run build:test && node lib-test/scripts/seedRoster.js",
    "seed:demo": "npm run build:test && node lib-test/scripts/seedDemo.js",
    "make-admin": "npm run build:test && node lib-test/scripts/makeAdmin.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.14.0",
    "firebase": "^13.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
