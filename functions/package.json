{
  "name": "functions",
  "description": "API server for the VVU Campus Safety app (runs on Vercel)",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "main": "lib/src/index.js",
  "scripts": {
    "lint": "eslint src api test scripts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "api:dev": "npm run build:test && node lib-test/scripts/devServer.js",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"lib-test/test/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vvu-campus-safety \"npm run test:rules:run\"",
    "test:rules:run": "npm run build:test && node --test --test-concurrency=1 \"lib-test/test/rules/**/*.test.js\"",
    "seed": "npm run build:test && node lib-test/scripts/seedRoster.js",
    "seed:demo": "npm run build:test && node lib-test/scripts/seedDemo.js",
    "make-admin": "npm run build:test && node lib-test/scripts/makeAdmin.js",
    "restore-backup": "npm run build:test && node lib-test/scripts/restoreBackup.js"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.14.0",
    "firebase": "^13.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
